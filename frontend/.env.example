# Frontend environment
# Copy to `.env` and fill in the values.

# --- Better Auth -----------------------------------------------------------
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
# Only needed when the auth API is served from a different origin than the app.
# NEXT_PUBLIC_BETTER_AUTH_URL="https://notices.example.edu"

# --- Supabase Postgres -----------------------------------------------------
# Runtime: the transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
# Migrations/scripts: the session pooler (port 5432).
DIRECT_DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Local SQLite file, read only by the one-off `scripts/backfill-supabase.ts`.
DB_FILE_NAME="mydb.sqlite"

# --- Seed accounts ---------------------------------------------------------
ADMIN_EMAIL="admin@user.pundra"
ADMIN_PASSWORD="replace-me"
# Display name for the bootstrap admin (defaults to the email local part).
ADMIN_NAME="Portal Administrator"
SEED_PASSWORD="replace-me"

# --- LensBot (RAG chatbot) --------------------------------------------------
# Groq generates the answers; Gemini (`GOOGLE_API_KEY`) embeds notices for
# pgvector retrieval and query embedding.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GOOGLE_API_KEY=""
EMBEDDING_MODEL="gemini-embedding-001"

# --- Backend API -----------------------------------------------------------
# Where the FastAPI backend is reachable.
BACKEND_URL="http://localhost:8000"
# Shared secret sent as `X-API-Key`. Must match API_KEY in `backend/.env`.
# Leave empty only while the backend runs without a key (development mode).
API_KEY=""
