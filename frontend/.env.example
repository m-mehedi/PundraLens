# Frontend environment
# Copy to `.env` and fill in the values.

# --- Better Auth -----------------------------------------------------------
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# --- Drizzle / SQLite ------------------------------------------------------
# Path to the frontend SQLite file, relative to `frontend/`.
DB_FILE_NAME="mydb.sqlite"

# --- Seed accounts ---------------------------------------------------------
ADMIN_EMAIL="admin@user.pundra"
ADMIN_PASSWORD="replace-me"
SEED_PASSWORD="replace-me"

# --- Backend API -----------------------------------------------------------
# Where the FastAPI backend is reachable.
BACKEND_URL="http://localhost:8000"
# Shared secret sent as `X-API-Key`. Must match API_KEY in `backend/.env`.
# Leave empty only while the backend runs without a key (development mode).
API_KEY=""
